# Copia este archivo como .env y rellénalo. El .env NUNCA se sube a GitHub.
# Identificador de esta máquina (CollectorId)
COLLECTOR_ID=VALENCIA-01
# Carpeta de datos (en el servidor: /srv/ais; en el PC, p. ej. C:/Users/marco/Desktop/TFG/ais_datos)
DATA_DIR=/srv/ais
# La API solo escucha dentro de la máquina; desde fuera se usa un túnel SSH
API_HOST=127.0.0.1
API_PORT=5080
# Token largo y aleatorio (ver README para generarlo)
API_TOKEN=cambia-esto-por-un-token-largo
# Clave de aisstream.io (obligatoria para esa fuente)
AISSTREAM_API_KEY=
# Clave de OpenSeaFeed (opcional: sin clave se usa el nivel libre)
OPENSEAFEED_API_KEY=
